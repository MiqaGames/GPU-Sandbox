{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build project",
            "type": "shell",
            "command": "C:/MSHP/VSCodeWinC/mingw64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-I",
                "src",
                "-g",
                "src/main.c",
                "src/components/core/core.c",
                "src/components/memory/memory.c",
                "src/components/debug/debug.c",
                "src/components/instruction/instruction.c",
                "src/components/simulator/simulator.c",
                "-o",
                "app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the whole C project with the proper include path for src/components."
        },
        {
            "label": "Run project",
            "type": "shell",
            "command": "./app.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Build project"
            ],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/MSHP/VSCodeWinC/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/MSHP/VSCodeWinC/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Generated by the debugger; not used for this project."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\Strawberry\\c\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Generated by the debugger; not used for this project."
        }
    ]
}
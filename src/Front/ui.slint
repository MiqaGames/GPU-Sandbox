									Rectangle { horizontal-stretch: 1; }
									Text { text: "HIT RATE"; color: #929b93; font-size: 9px; font-weight: 700; vertical-alignment: center; }
									Text { text: root.l1-rate; color: #4e743b; font-family: "Cascadia Code"; font-size: 12px; font-weight: 700; vertical-alignment: center; }
								}
								HorizontalLayout { height: 22px; Text { text: "L1  ·  4-way"; width: 82px; color: #59665d; font-size: 10px; vertical-alignment: center; } VerticalLayout { height: 22px; horizontal-stretch: 1; alignment: center; Rectangle { height: 7px; horizontal-stretch: 1; background: #e8ebe4; border-radius: 4px; Rectangle { width: 72%; height: 7px; background: #9bc85d; border-radius: 4px; } } } Text { text: "72%"; width: 34px; color: #657369; font-family: "Cascadia Code"; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; } }
								HorizontalLayout { height: 22px; Text { text: "L2  ·  8-way"; width: 82px; color: #59665d; font-size: 10px; vertical-alignment: center; } VerticalLayout { height: 22px; horizontal-stretch: 1; alignment: center; Rectangle { height: 7px; horizontal-stretch: 1; background: #e8ebe4; border-radius: 4px; Rectangle { width: 48%; height: 7px; background: #e2a36e; border-radius: 4px; } } } Text { text: "48%"; width: 34px; color: #657369; font-family: "Cascadia Code"; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; } }
								Rectangle { vertical-stretch: 1; }
								HorizontalLayout {
									height: 32px;
									Rectangle { horizontal-stretch: 1; background: #f3f5ef; border-radius: 3px; VerticalLayout { padding: 5px; spacing: 1px; Text { text: "HITS"; color: #89938a; font-size: 8px; font-weight: 700; } Text { text: root.l1-hits; color: #3f5d31; font-family: "Cascadia Code"; font-size: 10px; font-weight: 700; } } }
									Rectangle { width: 6px; }
									Rectangle { horizontal-stretch: 1; background: #f3f5ef; border-radius: 3px; VerticalLayout { padding: 5px; spacing: 1px; Text { text: "MISSES"; color: #89938a; font-size: 8px; font-weight: 700; } Text { text: root.l1-misses; color: #ad6944; font-family: "Cascadia Code"; font-size: 10px; font-weight: 700; } } }
									Rectangle { width: 6px; }
									Rectangle { horizontal-stretch: 1; background: #f3f5ef; border-radius: 3px; VerticalLayout { padding: 5px; spacing: 1px; Text { text: "EVICTIONS"; color: #89938a; font-size: 8px; font-weight: 700; } Text { text: root.l1-evictions; color: #59665d; font-family: "Cascadia Code"; font-size: 10px; font-weight: 700; } } }
								}
							}
						}
					}
				}
			}
		}
	}
}

FROM alpine:3.22 AS build

WORKDIR /src

RUN apk add --no-cache build-base

COPY . .

RUN mkdir -p /out && \
    gcc -std=c11 -I src tests/test_core.c src/components/core/core.c -o /out/test_core && \
    gcc -std=c11 -I src tests/test_memory.c src/components/memory/memory.c -o /out/test_memory && \
    gcc -std=c11 -I src tests/test_instruction.c src/components/core/core.c src/components/memory/memory.c src/components/instruction/instruction.c src/components/cache/cache.c -o /out/test_instruction && \
    gcc -std=c11 -I src tests/test_simulator.c src/components/core/core.c src/components/memory/memory.c src/components/instruction/instruction.c src/components/simulator/simulator.c src/components/cache/cache.c -o /out/test_simulator && \
    gcc -std=c11 -I src tests/test_debug.c src/components/core/core.c src/components/memory/memory.c src/components/instruction/instruction.c src/components/debug/debug.c src/components/cache/cache.c -o /out/test_debug && \
    gcc -std=c11 -I src tests/test_cache.c src/components/cache/cache.c -o /out/test_cache && \
    gcc -std=c11 -I src tests/test_builder.c src/components/builder/builder.c src/components/memory/memory.c -o /out/test_builder

FROM alpine:3.22

WORKDIR /app

COPY --from=build /out/ ./tests/

CMD ["sh", "-c", "./tests/test_core && ./tests/test_memory && ./tests/test_instruction && ./tests/test_simulator && ./tests/test_debug && ./tests/test_cache && ./tests/test_builder"]

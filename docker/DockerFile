FROM alpine:3.22 AS build

WORKDIR /src

RUN apk add --no-cache build-base

COPY . .

RUN mkdir -p /out && gcc -std=c11 -Wall -Wextra -I src \
    src/main.c \
    src/components/core/core.c \
    src/components/debug/debug.c \
    src/components/instruction/instruction.c \
    src/components/memory/memory.c \
    src/components/simulator/simulator.c \
    src/components/cache/cache.c \
    -o /out/app

FROM alpine:3.22

WORKDIR /app

COPY --from=build /out/app ./app

CMD ["./app"]
